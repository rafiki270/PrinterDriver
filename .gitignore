.worktrees/
build/
.build/
.swiftpm/
build-*/

# Android/Gradle (wrappers/android) -- build/ above already covers
# wrappers/android/build/ (and CMake's externalNativeBuild output under it); these
# cover the rest of what a real Gradle/Android Studio invocation would generate.
.gradle/
.cxx/
local.properties
*.iml
.idea/

# .NET (wrappers/dotnet). `runtimes/` is deliberately NOT ignored: a Windows release
# build stages printerdriver_capi.dll under
# wrappers/dotnet/PrinterDriver/runtimes/<rid>/native/ for `dotnet pack` to pick up, and
# whether that binary is committed is a release decision, not a gitignore one.
bin/
obj/
artifacts/
*.user
